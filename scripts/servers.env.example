# Copy to scripts/servers.env and fill in your own machines; servers.env is not tracked.
# Used by scripts/sync.sh to push code and launch jobs.
BHASKAR_HOST=user@host.example
BHASKAR_PORT=22
RAMANUJAN_HOST=user@host.example
RAMANUJAN_PORT=2022
SINGULARITY_HOST=user@host.example
SINGULARITY_PORT=2022
